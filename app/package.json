{
  "name": "@fvc/app",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "bun --bun vite build",
    "preview": "bun vite preview --host 127.0.0.1",
    "check": "tsgo --project tsconfig.json --noEmit",
    "deploy": "NODE_ENV='production' wrangler deploy",
    "types": "wrangler types --env-file='.env.example'"
  },
  "dependencies": {
    "@std/ulid": "npm:@jsr/std__ulid",
    "evlog": "catalog:",
    "livekit-server-sdk": "^2.15.4",
    "hono": "^4.12.23",
    "livekit-client": "^2.19.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.2",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/devtools": "^0.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typed-query-selector": "^2.12.2",
    "typescript": "catalog:",
    "vite": "^8.0.16",
    "wrangler": "^4.97.0"
  }
